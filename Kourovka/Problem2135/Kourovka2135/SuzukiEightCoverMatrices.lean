import Mathlib.LinearAlgebra.Matrix.GeneralLinearGroup.Defs
import Mathlib.Data.ZMod.Basic
import Mathlib.Data.Nat.Bitwise
import Mathlib.Tactic

/-! Exact ATLAS-source GF(5) matrix witnesses, generated by
computation/suzuki-eight-cover/generate_lean_words.py. Integer source entries
were multiplied by 2 modulo 5, implementing the source's GAP Z(5) convention.
All equalities are checked by ordinary Lean decide. These finite identities
alone do not identify the group, prove its order, or establish a cover.
-/

set_option autoImplicit false
set_option maxRecDepth 16384
set_option maxHeartbeats 8000000
namespace Kourovka2135.SuzukiEightCoverMatrices
open Matrix
abbrev M := Matrix (Fin 24) (Fin 24) (ZMod 5)
/-- Row-major entries packed in three-bit digits; each decoded digit is cast to GF5. -/
def unpackMatrix (code : ℕ) : M := fun i j =>
  ((Nat.shiftRight code (3 * (24 * i.val + j.val)) % 8 : ℕ) : ZMod 5)
abbrev UnitMatrix := Matrix.GeneralLinearGroup (Fin 24) (ZMod 5)

def cMatrix : M := unpackMatrix 

def cInverse : M := unpackMatrix 

theorem c_mul_inverse : cMatrix * cInverse = 1 := by decide +kernel
theorem c_inverse_mul : cInverse * cMatrix = 1 := by decide +kernel
def c : UnitMatrix := ⟨cMatrix, cInverse, c_mul_inverse, c_inverse_mul⟩

