import Kourovka2135.GeneratingSets
import Mathlib.GroupTheory.Torsion

/-!
# Soluble groups generated by commutator-closed sets of p-elements

A derived-subgroup induction proves the needed p-group conclusion directly;
this can replace a single-value focal theorem in the derived-word base case.
-/

set_option autoImplicit false
universe u
namespace Kourovka2135

/-- An abelian group generated by p-elements is a p-group. -/
theorem isPGroup_of_commutative_generators {G : Type u} [CommGroup G] {p : ℕ}
    {X : Set G} (hgen : Subgroup.closure X = ⊤)
    (hpow : ∀ x ∈ X, ∃ n : ℕ, x ^ p ^ n = 1) : IsPGroup p G := by
  have hle : Subgroup.closure X ≤ CommGroup.primaryComponent G p :=
    (Subgroup.closure_le _).mpr hpow
  intro g
  have hg : g ∈ Subgroup.closure X := by rw [hgen]; trivial
  exact hle hg

/-- A finite soluble group generated by a commutator-closed set of p-elements
is a p-group. No single-value focal theorem is used. -/
theorem isPGroup_of_soluble_commutatorClosed_generators
    {G : Type u} [Group G] [Finite G] {p : ℕ}
    (hsolv : Group.IsSolvable G) {X : Set G}
    (hX : IsCommutatorClosed X) (hgen : Subgroup.closure X = ⊤)
    (hpow : ∀ x ∈ X, ∃ n : ℕ, x ^ p ^ n = 1) : IsPGroup p G := by
  classical
  let T : ℕ → Prop := fun n =>
    ∀ (K : Type u) [Group K] [Finite K], Nat.card K = n → Group.IsSolvable K →
      ∀ Y : Set K, IsCommutatorClosed Y → Subgroup.closure Y = ⊤ →
        (∀ y ∈ Y, ∃ m : ℕ, y ^ p ^ m = 1) → IsPGroup p K
  have main : ∀ n, T n := by
    intro n
    refine Nat.strong_induction_on n ?_
    intro n ih K _ _ hcard hK Y hY hYgen hYpow
    have : Group.IsSolvable K := hK
    rcases subsingleton_or_nontrivial K with htriv | hnontriv
    · let := htriv
      exact IsPGroup.of_subsingleton p K
    · let := hnontriv
      let D := commutator K
      let Z := commutatorImage Y Y
      let W : Set D := {x | (x : K) ∈ Z}
      have hZ : IsCommutatorClosed Z := hY.commutatorImage
      have hZgen : Subgroup.closure Z = D :=
        (commutator_eq_closure_commutatorImage hY hYgen).symm
      have himage : D.subtype '' W = Z := by
        ext x
        refine ⟨fun ⟨y, hy, heq⟩ => heq ▸ hy, fun hx => ?_⟩
        have hmem : x ∈ D := by rw [← hZgen]; exact Subgroup.subset_closure hx
        exact ⟨⟨x, hmem⟩, hx, rfl⟩
      have hWgen : Subgroup.closure W = ⊤ := by
        apply Subgroup.map_injective D.subtype_injective
        rw [MonoidHom.map_closure, himage, hZgen,
          ← MonoidHom.range_eq_map, D.range_subtype]
      have hW : IsCommutatorClosed W := by
        intro x hx y hy
        exact hZ x hx y hy
      have hWpow : ∀ x ∈ W, ∃ m : ℕ, x ^ p ^ m = 1 := by
        intro x hx
        obtain ⟨m, hm⟩ := hYpow x (commutatorImage_subset hY hx)
        exact ⟨m, Subtype.ext hm⟩
      have hlt : Nat.card D < n := by
        rw [← hcard]
        simpa only [Subgroup.card_top] using Subgroup.card_lt_of_lt
          (Group.IsSolvable.commutator_lt_top_of_nontrivial K)
      have hD : IsPGroup p D := ih (Nat.card D) hlt D rfl
        (by infer_instance) W hW hWgen hWpow
      let f : K →* Abelianization K := Abelianization.of
      have hf : Function.Surjective f := QuotientGroup.mk'_surjective D
      have hqgen : Subgroup.closure (f '' Y) = ⊤ := by
        rw [← MonoidHom.map_closure, hYgen, Subgroup.map_top_of_surjective f hf]
      have hqpow : ∀ x ∈ f '' Y, ∃ m : ℕ, x ^ p ^ m = 1 := by
        rintro _ ⟨y, hy, rfl⟩
        obtain ⟨m, hm⟩ := hYpow y hy
        exact ⟨m, by rw [← map_pow, hm, map_one]⟩
      have hQ : IsPGroup p (Abelianization K) :=
        isPGroup_of_commutative_generators hqgen hqpow
      have hker : IsPGroup p f.ker := by
        have hfker : f.ker = D := Abelianization.ker_of K
        rw [hfker]
        exact hD
      intro g
      obtain ⟨a, ha⟩ := hQ (f g)
      have hmem : g ^ p ^ a ∈ f.ker := by
        rw [MonoidHom.mem_ker, map_pow, ha]
      obtain ⟨b, hb⟩ := hker ⟨g ^ p ^ a, hmem⟩
      refine ⟨a + b, ?_⟩
      have heq : (g ^ p ^ a) ^ p ^ b = 1 := congrArg Subtype.val hb
      simpa only [← pow_mul, ← pow_add] using heq
  exact main (Nat.card G) G rfl hsolv X hX hgen hpow

/-- In a finite soluble ambient group, a commutator-closed set of p-elements generates
a p-subgroup, without assuming that it generates the ambient group. -/
theorem isPGroup_closure_of_soluble_commutatorClosed
    {G : Type u} [Group G] [Finite G] {p : ℕ}
    (hsolv : Group.IsSolvable G) {X : Set G}
    (hX : IsCommutatorClosed X)
    (hpow : ∀ x ∈ X, ∃ n : ℕ, x ^ p ^ n = 1) :
    IsPGroup p (Subgroup.closure X) := by
  have : Group.IsSolvable G := hsolv
  let K := Subgroup.closure X
  let Y : Set K := {x | (x : G) ∈ X}
  have himage : K.subtype '' Y = X := by
    ext x
    exact ⟨fun ⟨y, hy, heq⟩ => heq ▸ hy,
      fun hx => ⟨⟨x, Subgroup.subset_closure hx⟩, hx, rfl⟩⟩
  have hYgen : Subgroup.closure Y = ⊤ := by
    apply Subgroup.map_injective K.subtype_injective
    rw [MonoidHom.map_closure, himage, ← MonoidHom.range_eq_map, K.range_subtype]
  have hY : IsCommutatorClosed Y := by
    intro x hx y hy
    exact hX x hx y hy
  have hYpow : ∀ x ∈ Y, ∃ n : ℕ, x ^ p ^ n = 1 := by
    intro x hx
    obtain ⟨n, hn⟩ := hpow x hx
    exact ⟨n, Subtype.ext hn⟩
  exact isPGroup_of_soluble_commutatorClosed_generators
    (by infer_instance) hY hYgen hYpow

end Kourovka2135
