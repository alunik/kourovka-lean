def coverPc : Fin 8 → SuzukiEightCoverMatrices.UnitMatrix :=
  ![SuzukiEightCoverPcMatrices.pc0, SuzukiEightCoverPcMatrices.pc1,
    SuzukiEightCoverPcMatrices.pc2, SuzukiEightCoverPcMatrices.pc3,
    SuzukiEightCoverPcMatrices.pc4, SuzukiEightCoverPcMatrices.pc5,
    SuzukiEightCoverPcMatrices.pc6, SuzukiEightCoverPcMatrices.pc7]

theorem code_form_eq_word (i : Fin 256) :
    SuzukiEightCoverCodeForms.form i = FiniteEightPcWords.word (G := SuzukiEightCoverCodeMatrices.UnitMatrix) codePc i := by
  fin_cases i <;> rfl

theorem cover_form_eq_word (i : Fin 256) :
    SuzukiEightCoverPcForms.form i = FiniteEightPcWords.word (G := SuzukiEightCoverMatrices.UnitMatrix) coverPc i := by
  fin_cases i <;> rfl

theorem pcAmbient_eq_pair (j : Fin 8) :
    pcAmbient j = (codePc j, coverPc j) := by
  fin_cases j <;> rfl

theorem formAmbient_eq_word (i : Fin 256) :
    formAmbient i = FiniteEightPcWords.word (G := Ambient) pcAmbient i := by
  have hpc : (fun j => (codePc j, coverPc j)) = pcAmbient := by
    funext j
    exact (pcAmbient_eq_pair j).symm
  calc
    formAmbient i = (FiniteEightPcWords.word (G := SuzukiEightCoverCodeMatrices.UnitMatrix) codePc i,
        FiniteEightPcWords.word (G := SuzukiEightCoverMatrices.UnitMatrix) coverPc i) :=
      Prod.ext (code_form_eq_word i) (cover_form_eq_word i)
    _ = FiniteEightPcWords.word (G := Ambient) (fun j => (codePc j, coverPc j)) i :=
      FiniteEightPcWords.word_prod (A := SuzukiEightCoverCodeMatrices.UnitMatrix)
        (B := SuzukiEightCoverMatrices.UnitMatrix) codePc coverPc i
    _ = FiniteEightPcWords.word (G := Ambient) pcAmbient i :=
      congrArg (fun p : Fin 8 → Ambient => FiniteEightPcWords.word (G := Ambient) p i) hpc

theorem formAmbient_mem (H : Subgroup Ambient) (hp : ∀ j, pcAmbient j ∈ H)
    (i : Fin 256) : formAmbient i ∈ H := by
  rw [formAmbient_eq_word]
  exact FiniteEightPcWords.word_mem (G := Ambient) H pcAmbient hp i

def form (i : Fin 256) : E := ⟨formAmbient i, formAmbient_mem coverGroup pcAmbient_mem i⟩

theorem form_val (i : Fin 256) : (form i).val = (SuzukiEightCoverCodeForms.form i, SuzukiEightCoverPcForms.form i) := rfl

theorem form_code_val (i : Fin 256) : ((form i).val.1 : SuzukiEightCoverCodeMatrices.M) = SuzukiEightCoverCodeForms.raw i :=
  SuzukiEightCoverCodeForms.form_val i

theorem form_cover_val (i : Fin 256) : ((form i).val.2 : SuzukiEightCoverMatrices.M) = SuzukiEightCoverPcForms.raw i :=
  SuzukiEightCoverPcForms.form_val i

theorem form_mem (H : Subgroup E) (hp : ∀ j, pc j ∈ H)
    (i : Fin 256) : form i ∈ H := by
  have ha : ∀ j, pcAmbient j ∈ H.map coverGroup.subtype := by
    intro j
    exact Subgroup.mem_map.mpr ⟨pc j, hp j, pc_val j⟩
  obtain ⟨g, hg, he⟩ := formAmbient_mem (H.map coverGroup.subtype) ha i
  have he' : g = form i := Subtype.ext he
  exact he' ▸ hg

