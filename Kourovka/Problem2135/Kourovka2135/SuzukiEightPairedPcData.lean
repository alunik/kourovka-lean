def formAmbient (i : Fin 256) : Ambient := (SuzukiEightCoverCodeForms.form i, SuzukiEightCoverPcForms.form i)

def codePc : Fin 8 → SuzukiEightCoverCodeMatrices.UnitMatrix :=
  ![SuzukiEightCoverCodeMatrices.pc0, SuzukiEightCoverCodeMatrices.pc1,
    SuzukiEightCoverCodeMatrices.pc2, SuzukiEightCoverCodeMatrices.pc3,
