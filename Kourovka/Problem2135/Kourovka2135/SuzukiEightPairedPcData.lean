  closure_pair_eq_top_of_subtype_closure coverGroup C B rfl

theorem C_inv : C⁻¹ = C := by
  apply Subtype.ext
  apply Prod.ext
  · apply Units.ext
    rfl
  · apply Units.ext
    rfl

