theorem step_C_inv (i : Fin 65) : ∃ j : Fin 65, rep i * C⁻¹ * (rep j)⁻¹ ∈ H := by
  rw [C_inv]
  exact step_C i

theorem step (i : Fin 65) (s : E) (hs : s ∈ ({C, B} : Set E)) :
    ∃ j : Fin 65, rep i * s * (rep j)⁻¹ ∈ H := by
  rcases Set.mem_insert_iff.mp hs with rfl | hs
  · exact step_C i
  · obtain rfl := Set.mem_singleton_iff.mp hs
    exact step_B i

theorem stepInv (i : Fin 65) (s : E) (hs : s ∈ ({C, B} : Set E)) :
    ∃ j : Fin 65, rep i * s⁻¹ * (rep j)⁻¹ ∈ H := by
  rcases Set.mem_insert_iff.mp hs with rfl | hs
  · exact step_C_inv i
  · obtain rfl := Set.mem_singleton_iff.mp hs
    exact step_B_inv i

