theorem transition_mem {i j : Fin 65} {s : E} (a : Fin 256) (e : ℕ)
    (h : rep i * s = form a * torus ^ e * rep j) : rep i * s * (rep j)⁻¹ ∈ H := by
  rw [h]
  simp only [mul_assoc, mul_inv_cancel, mul_one]
  exact H.mul_mem (form_mem_H a) (H.pow_mem torus_mem_H e)

