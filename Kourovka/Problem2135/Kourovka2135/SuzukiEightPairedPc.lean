def P : Subgroup E := Subgroup.closure (Set.range pc)

theorem pc_mem (i : Fin 8) : pc i ∈ P := Subgroup.subset_closure ⟨i, rfl⟩

theorem form_mem_P (i : Fin 256) : form i ∈ P := form_mem P pc_mem i

theorem card_P_le : Nat.card P ≤ 256 := by
  simpa [P] using FinitePcCertificate.card_closure_le pc square_mem conjugate_mem

theorem torus_conjugate_mem (i : Fin 8) : torus⁻¹ * pc i * torus ∈ P := by
  fin_cases i
  · change torus⁻¹ * pc0 * torus ∈ P
    rw [torusConjugate0]
    exact form_mem_P 177
  · change torus⁻¹ * pc1 * torus ∈ P
    rw [torusConjugate1]
    exact form_mem_P 238
  · change torus⁻¹ * pc2 * torus ∈ P
    rw [torusConjugate2]
    exact form_mem_P 213
  · change torus⁻¹ * pc3 * torus ∈ P
    rw [torusConjugate3]
    exact form_mem_P 10
  · change torus⁻¹ * pc4 * torus ∈ P
    rw [torusConjugate4]
    exact form_mem_P 5
  · change torus⁻¹ * pc5 * torus ∈ P
    rw [torusConjugate5]
    exact form_mem_P 22
  · change torus⁻¹ * pc6 * torus ∈ P
    rw [torusConjugate6]
    exact form_mem_P 2
  · change torus⁻¹ * pc7 * torus ∈ P
    rw [torusConjugate7]
    exact form_mem_P 1

theorem torus_normalizes : torus ∈ Subgroup.normalizer (P : Set E) := by
  apply FiniteAdjoinCard.mem_normalizer_closure_of_generators
  rintro g ⟨i, rfl⟩
  exact torus_conjugate_mem i

def H : Subgroup E := P ⊔ Subgroup.zpowers torus

theorem P_le_H : P ≤ H := le_sup_left

theorem torus_mem_H : torus ∈ H :=
  (le_sup_right : Subgroup.zpowers torus ≤ H) (Subgroup.mem_zpowers torus)

theorem form_mem_H (i : Fin 256) : form i ∈ H := P_le_H (form_mem_P i)

theorem card_H_le : Nat.card H ≤ 1792 := by
  have h := FiniteAdjoinCard.card_le P torus torus_normalizes 7 (by decide)
    (show torus ^ 7 ∈ P by rw [torus_seventh]; exact P.one_mem)
  exact h.trans (Nat.mul_le_mul_right 7 card_P_le)

